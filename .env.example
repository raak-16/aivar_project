# Mistral credential used by the local TradingAgents research pipeline.
MISTRAL_API_KEY=replace-with-your-key

# Optional: select the Mistral models available to your account.
MISTRAL_DEEP_THINK_MODEL=mistral-small-latest
MISTRAL_QUICK_THINK_MODEL=mistral-small-latest

# Keep the multi-agent debates short for interactive dashboard requests.
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
